{
  "comment": "Shared vectors for the single-target rule: reject empty, a leading '-', and any Unicode White_Space or Cc character; everything else reaches bazel as one verbatim argument. Consumed by the core (src-tauri/src/runargs.rs tests) and the UI (tests/target.test.ts). Edit here to change both sides at once.",
  "accepted": [
    {
      "target": "//app/lib:parser"
    },
    {
      "target": "//..."
    },
    {
      "target": ":all"
    },
    {
      "target": ":*"
    },
    {
      "target": "@maven//:guava"
    },
    {
      "target": "//app/..."
    },
    {
      "target": "//app:tar;get",
      "why": "shell metacharacters are ordinary label characters in one verbatim argument"
    },
    {
      "target": "//a:b$(id)"
    },
    {
      "target": "//a:b`id`"
    },
    {
      "target": "//a:b&&c"
    },
    {
      "target": "//a:b|c"
    },
    {
      "target": "//a:b>c"
    },
    {
      "target": "//a:\ufeffb",
      "why": "U+FEFF is neither White_Space nor Cc"
    },
    {
      "target": "//a:\u00adb",
      "why": "U+00AD is neither White_Space nor Cc"
    }
  ],
  "rejected": [
    {
      "target": "",
      "why": "empty"
    },
    {
      "target": " ",
      "why": "whitespace"
    },
    {
      "target": "//a:b "
    },
    {
      "target": "//a:b\t"
    },
    {
      "target": "a\tb"
    },
    {
      "target": "a\nb"
    },
    {
      "target": "a\u0000b",
      "why": "NUL is Cc"
    },
    {
      "target": "-//a:b",
      "why": "a leading dash could read as a flag"
    },
    {
      "target": "\u3000",
      "why": "U+3000 is White_Space"
    },
    {
      "target": "//a:b; id",
      "why": "interior whitespace is still whitespace"
    },
    {
      "target": "//a:\u00a0b",
      "why": "U+00A0 (NBSP) is White_Space"
    },
    {
      "target": "//a:\u0085b",
      "why": "U+0085 is White_Space"
    },
    {
      "target": "//a:\u009fb",
      "why": "U+009F is Cc"
    },
    {
      "target": "//a:\u001fb",
      "why": "U+001F is Cc"
    },
    {
      "target": "//a:\u007fb",
      "why": "U+007F is Cc"
    },
    {
      "target": "//a:\u2028b",
      "why": "U+2028 is White_Space"
    },
    {
      "target": "//a:\u2029b",
      "why": "U+2029 is White_Space"
    }
  ]
}

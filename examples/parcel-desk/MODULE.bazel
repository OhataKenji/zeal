module(name = "parcel_desk", version = "0.1.0")

# gRPC 1.71.0's own rules, loaded from the grpc module. repo_name keeps the
# conventional @com_github_grpc_grpc label used by grpc's BUILD files.
bazel_dep(name = "grpc", version = "1.71.0", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "protobuf", version = "29.0", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_proto", version = "7.0.2")
bazel_dep(name = "rules_python", version = "0.40.0")
# Xcode 27's clang lists SDKSettings.json in depfiles, which the rules_cc
# auto-configured toolchain rejects as an absolute path inclusion. Newer
# apple_support releases self-register their maintained cc toolchain.
bazel_dep(name = "apple_support", version = "1.24.5")

# Python 3.12 matches the interpreter protobuf's Bazel python runtime is
# built against (@system_python inside @com_google_protobuf). grpc and
# protobuf each register their own default toolchains; pinning the same
# version here keeps resolution deterministic.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(is_default = True, python_version = "3.12")

# grpc pins protoc-gen-validate 1.2.1, whose BCR MODULE.bazel calls
# pip.parse(name=...), an attribute rules_python removed by 0.40 (envoy_api
# requires rules_python 0.40.0), breaking module resolution on Bazel 7.6.1.
# The 1.2.1.bcr.1 republish carries the same sources with a fixed MODULE.bazel.
single_version_override(
    module_name = "protoc-gen-validate",
    version = "1.2.1.bcr.1",
)

# grpc-java 1.66 still imports the retired grpc repository extension.
single_version_override(module_name = "grpc-java", version = "1.69.0")
